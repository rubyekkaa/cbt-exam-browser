diff --git a/.github/workflows/build-android.yml b/.github/workflows/build-android.yml
index 84da38d..ba90ff2 100644
--- a/.github/workflows/build-android.yml
+++ b/.github/workflows/build-android.yml
@@ -42,6 +42,10 @@ jobs:
         run: ./gradlew assembleRelease
         working-directory: android
 
+      - name: Build Release AAB (for Play Store)
+        run: ./gradlew bundleRelease
+        working-directory: android
+
       - name: Upload Debug APK
         uses: actions/upload-artifact@v4
         with:
@@ -54,6 +58,12 @@ jobs:
           name: cbt-exam-browser-release
           path: android/app/build/outputs/apk/release/*.apk
 
+      - name: Upload Release AAB (Play Store)
+        uses: actions/upload-artifact@v4
+        with:
+          name: cbt-exam-browser-release-aab
+          path: android/app/build/outputs/bundle/release/*.aab
+
       - name: Create Release
         if: startsWith(github.ref, 'refs/tags/v')
         uses: softprops/action-gh-release@v1
@@ -61,5 +71,6 @@ jobs:
           files: |
             android/app/build/outputs/apk/debug/*.apk
             android/app/build/outputs/apk/release/*.apk
+            android/app/build/outputs/bundle/release/*.aab
         env:
           GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
diff --git a/android/app/build.gradle.kts b/android/app/build.gradle.kts
index 14143c6..b60379a 100644
--- a/android/app/build.gradle.kts
+++ b/android/app/build.gradle.kts
@@ -15,10 +15,20 @@ android {
         versionName = "1.0.0"
     }
 
+    signingConfigs {
+        create("release") {
+            storeFile = file("release-keystore.jks")
+            storePassword = System.getenv("KEYSTORE_PASSWORD") ?: "cbtexam2024"
+            keyAlias = "cbt-exam-browser"
+            keyPassword = System.getenv("KEY_PASSWORD") ?: "cbtexam2024"
+        }
+    }
+
     buildTypes {
         release {
             isMinifyEnabled = true
             isShrinkResources = true
+            signingConfig = signingConfigs.getByName("release")
             proguardFiles(
                 getDefaultProguardFile("proguard-android-optimize.txt"),
                 "proguard-rules.pro"
